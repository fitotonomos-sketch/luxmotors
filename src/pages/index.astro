---
import SiteLayout from '../layouts/SiteLayout.astro';
import BannerCarousel from '../components/BannerCarousel';
import VehicleShowcase from '../components/VehicleShowcase';
import ConsultationLink from '../components/ConsultationLink';
---
<SiteLayout title="لوکس موتورز | خودروهای وارداتی منطقه آزاد" description="گزیده‌ای از خودروهای وارداتی ممتاز از لوکس موتورز.">
  <section class="lux-hero" id="hero"><div class="lux-hero-image"><img src="https://cdn.b12.io/client_media/oonrTCvL/3cf5da1a-d6c4-11f1-b329-0242ac110002-wide-cinematic-luxury-automotive-editorial-photograph-for-a-.jpg" alt="خودروی شاسی‌بلند لوکس در فضای ساحلی" fetchpriority="high" decoding="async"/><div class="lux-hero-shade"></div></div><div class="lux-hero-copy"><span class="lux-eyebrow"><i></i><span data-copy-key="hero.eyebrow">LUX MOTORS · FREE ZONE</span></span><h1><span data-copy-key="hero.title">وقارِ حرکت،</span><br/><em data-copy-key="hero.title_emphasis">فراتر از مسیر.</em></h1><p data-copy-key="hero.description">گزیده‌ای از خودروهای وارداتی ممتاز؛ برای کسانی که کیفیت را در هر جزئیات می‌شناسند.</p><a href="#featured" class="lux-cta"><span data-copy-key="hero.cta">کشف مجموعه خودروها</span><span aria-hidden="true">←</span></a><div class="lux-hero-note" data-copy-key="hero.note">انتخاب ممتاز · همراهی شفاف · تجربه‌ای شخصی</div></div><div class="lux-hero-chip">Alpha Site<br/><b>Premium Vesion</b></div></section>
  <BannerCarousel client:load />
  <section class="lux-intro" id="about"><span class="lux-eyebrow" data-copy-key="about.eyebrow">فراتر از یک انتخاب</span><p><span data-copy-key="about.title">ترکیب مهندسی پیشرفته، طراحی ماندگار و</span> <em data-copy-key="about.emphasis">آزادیِ انتخاب.</em></p><span data-copy-key="about.signature">لوکس موتورز · منطقه آزاد</span></section>
  <section class="lux-cars page-shell" id="featured"><div class="lux-section-head"><div><span class="lux-eyebrow" data-copy-key="featured.eyebrow">منتخب لوکس موتورز</span><h2 data-copy-key="featured.title">خودروهایی برای تمایز.</h2></div><a class="lux-cta lux-cta-light" href="/store" data-copy-key="featured.link">مشاهده همه خودروها ←</a></div><VehicleShowcase client:load/><p class="lux-sample-note" data-copy-key="featured.disclaimer">مشخصات و قیمت‌های نمونه نمایشی فرضی‌اند؛ اطلاعات خودروی واقعی را پیش از خرید استعلام و کارشناسی کنید.</p></section>
  <section class="lux-promise" id="services"><span class="lux-eyebrow" data-copy-key="services.eyebrow">جزئیات، همان تفاوت‌اند</span><div><article><b>01</b><h3 data-copy-key="services.item1.title">انتخاب دقیق</h3><p data-copy-key="services.item1.body">تمرکز بر خودروهای شاخص و نسخه‌های ممتاز.</p></article><article><b>02</b><h3 data-copy-key="services.item2.title">اطلاعات شفاف</h3><p data-copy-key="services.item2.body">وضعیت هر خودروی واقعی باید با گزارش کارشناسی و اسناد معتبر تأیید شود.</p></article><article><b>03</b><h3 data-copy-key="services.item3.title">همراهی اختصاصی</h3><p data-copy-key="services.item3.body">برای دریافت اطلاعات موجودی و مشاوره با ما در تماس باشید.</p></article></div><ConsultationLink client:load /></section>
</SiteLayout>
